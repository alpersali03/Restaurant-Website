@using Restaurant.DTOs
@model IReadOnlyList<PaymentDto>

<h2>Payments</h2>

@if (!Model.Any())
{
    <p class="text-muted">No payment attempts recorded yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order</th>
                <th>Amount</th>
                <th>Provider</th>
                <th>Status</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model)
            {
                <tr>
                    <td>@payment.OrderId</td>
                    <td>@payment.Amount.ToString("C")</td>
                    <td>@payment.Provider</td>
                    <td>@payment.Status</td>
                    <td>@payment.CreatedAt.ToLocalTime()</td>
                    <td>
                        <a asp-controller="Payment" asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
