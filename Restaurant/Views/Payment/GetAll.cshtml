@using Restaurant.DTOs
@using Restaurant.Data.Models
@model List<PaymentFormDto>

<a asp-controller="Payment" asp-action="GetAll" class="btn btn-primary mb-3">Go Back</a>

<div class="row">
    @foreach (var payment in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title text-center">Payment Method: @payment.Method</h5>

                    <a asp-controller="Payment" asp-action="Edit" asp-route-id="@payment.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="Payment" asp-action="Delete" asp-route-id="@payment.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this payment?')">Delete</a>
                </div>
            </div>
        </div>
    }
</div>
