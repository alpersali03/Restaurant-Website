@model List<Restaurant.DTOs.CategoryFormDto>

@{
    ViewData["Title"] = "Categories";
}

<section class="page-panel">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Admin • Categories</span>
            <h1 class="mb-2">Manage categories</h1>
            <p class="table-note">Control the structure customers see across the menu and homepage.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Category" asp-action="Add" class="btn btn-dark">Add category</a>
        </div>
    </div>

    <div class="admin-grid">
        @foreach (var category in Model)
        {
            <article class="admin-card">
                <img src="@category.IconUrl" class="admin-card-image" alt="@category.Name" />
                <div class="admin-card-body">
                    <div>
                        <h3>@category.Name</h3>
                        <p>Used for customer navigation and menu grouping.</p>
                    </div>

                    <div class="metric-row">
                        <span class="metric-label">Assigned products</span>
                        <span class="metric-pill">@category.Products.Count</span>
                    </div>

                    <div class="admin-card-actions">
                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-controller="Category" asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@category.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
