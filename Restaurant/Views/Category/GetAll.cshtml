@using Restaurant.DTOs
@using Restaurant.Data.Models
@model List<CategoryFormDto>

<a asp-controller="Category" asp-action="GetAll" class="btn btn-primary mb-3 top-0 left-0" type="submit">GoBack</a>
@*  <form asp-controller="Category" asp-action="Search" method="get">
 	<div>
 		<input type="text" name="keyword" class="form-control" placeholder="Enter a searching keyword" />
 		<button class="btn btn-primary mt-3" type="submit"> Search</button>
 	</div>
 </form> *@


<div class="row">
	@foreach (var product in Model)
	{
		<div class="col-md-4">
			<div class="card mb-3">
				<div class="card-body text-center">
					<h5 class="card-title text-center"> @product.Name</h5>
					<img src=@product.IconUrl class="img-fluid" alt="Cinque Terre">
					<p class="card-title text-center"> Products count: @product.Products.Count()</p>

					<a asp-controller="Category" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning">Edit</a>
					@*<a asp-controller="Product" asp-action="ProductsByCategory" asp-route-categoryId="@product.Id" class="btn btn-primary">Products by category</a>*@
					<a asp-controller="Category" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger" onclick="myFunction() ">Delete</a>
				</div>
			</div>
		</div>
	}
</div>
