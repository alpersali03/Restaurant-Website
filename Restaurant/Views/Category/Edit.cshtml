@model Restaurant.DTOs.CategoryFormDto

@{
    ViewData["Title"] = "Edit Category";
}

<section class="page-panel admin-form-shell">
    <div class="page-header">
        <div>
            <span class="eyebrow">Admin • Categories</span>
            <h1>Edit category</h1>
            <p>Update the category name and artwork used across menu browsing surfaces.</p>
        </div>
        <a asp-controller="Category" asp-action="GetAll" class="btn btn-outline-dark">Back to categories</a>
    </div>

    <form method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="admin-form-grid">
            <div class="form-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="IconUrl"></label>
                <input asp-for="IconUrl" class="form-control" />
                <span asp-validation-for="IconUrl" class="small text-danger"></span>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-dark" type="submit">Save changes</button>
            <a asp-controller="Category" asp-action="GetAll" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</section>
