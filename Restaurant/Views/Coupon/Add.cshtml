@model Restaurant.DTOs.CouponFormDto

@{
    ViewData["Title"] = "Add Coupon";
}

<section class="page-panel admin-form-shell">
    <div class="page-header">
        <div>
            <span class="eyebrow">Admin • Coupons</span>
            <h1>Add coupon</h1>
            <p>Create a new offer with a code, discount level, and validity window.</p>
        </div>
        <a asp-controller="Coupon" asp-action="GetAll" class="btn btn-outline-dark">Back to coupons</a>
    </div>

    <form method="post" class="admin-form">
        @Html.AntiForgeryToken()

        <div class="admin-form-grid">
            <div class="form-field">
                <label asp-for="Code"></label>
                <input asp-for="Code" class="form-control" placeholder="WELCOME10" />
                <span asp-validation-for="Code" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Percentage"></label>
                <select asp-for="Percentage" class="form-select">
                    <option value="5">5%</option>
                    <option value="10">10%</option>
                    <option value="20">20%</option>
                    <option value="30">30%</option>
                </select>
                <span asp-validation-for="Percentage" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="small text-danger"></span>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-dark" type="submit">Save coupon</button>
            <a asp-controller="Coupon" asp-action="GetAll" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</section>
