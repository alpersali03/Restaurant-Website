@using Restaurant.DTOs
@model List<ReviewFormDto>

<a asp-controller="Review" asp-action="Add" class="btn btn-primary mb-3">Add Review</a>

<div class="row">
    @foreach (var review in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">Rating: @review.Rating ⭐</h5>
                    <p class="card-text">Customer: @review.CustomerName</p>
                    <p class="card-text">Comment: @review.Comment</p>
                    <p class="card-text">Created: @review.CreatedAt.ToShortDateString()</p>
                    <p class="card-text">Product ID: @review.ProductId</p>

                    <a asp-controller="Review" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="Review" asp-action="Delete" asp-route-id="@review.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this review?');">Delete</a>
                </div>
            </div>
        </div>
    }
</div>
