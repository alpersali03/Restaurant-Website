@model List<Restaurant.DTOs.ReviewFormDto>

@{
    ViewData["Title"] = "Reviews";
}

<section class="page-panel">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Admin • Reviews</span>
            <h1 class="mb-2">Manage guest reviews</h1>
            <p class="table-note">Moderate product feedback and keep review copy organized.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Review" asp-action="Add" class="btn btn-dark">Add review</a>
        </div>
    </div>

    <div class="admin-grid">
        @foreach (var review in Model)
        {
            <article class="admin-card">
                <div class="admin-card-body">
                    <div class="admin-card-topline">
                        <span class="metric-pill">@review.Rating/5</span>
                        <span class="metric-label">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>

                    <div>
                        <h3>@review.CustomerName</h3>
                        <p>@review.ProductName</p>
                    </div>

                    <p>@review.Comment</p>

                    <div class="admin-card-actions">
                        <a asp-controller="Review" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-controller="Review" asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
