@model Restaurant.DTOs.ReservationFormDto

@{
    ViewData["Title"] = "Add Reservation";
}

<section class="page-panel admin-form-shell">
    <div class="page-header">
        <div>
            <span class="eyebrow">Admin • Reservations</span>
            <h1>Add reservation</h1>
            <p>Create a booking with guest count, notes, and status.</p>
        </div>
        <a asp-controller="Reservation" asp-action="GetAll" class="btn btn-outline-dark">Back to reservations</a>
    </div>

    <form method="post" class="admin-form">
        @Html.AntiForgeryToken()

        <div class="admin-form-grid">
            <div class="form-field">
                <label asp-for="CustomerName"></label>
                <input asp-for="CustomerName" class="form-control" placeholder="John Smith" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+359..." />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="ReservationDate"></label>
                <input asp-for="ReservationDate" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="ReservationDate" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="GuestCount"></label>
                <input asp-for="GuestCount" class="form-control" placeholder="4" />
                <span asp-validation-for="GuestCount" class="text-danger small"></span>
            </div>

            <div class="form-field form-field-full">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control" placeholder="Window seat, allergy note, occasion details."></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            <div class="form-field">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Restaurant.Data.Models.ReservationStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-dark" type="submit">Save reservation</button>
            <a asp-controller="Reservation" asp-action="GetAll" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</section>
