@using Restaurant.DTOs
@using Restaurant.Data.Models
@model List<ProductDto>

<a asp-controller="Product" asp-action="GetAll" class="btn btn-primary mb-3 top-0 left-0">Go Back</a>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title text-center">@product.Name</h5>
                    <img src="@product.ImageUrl" class="img-fluid" alt="Image of @product.Name">
                    <p class="card-text">Product description: @product.Description</p>
                    <p class="card-text">Product category: @product.Category.Name</p>
                    <p class="card-text">Product price: @product.Price</p>

                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-warning">Details</a>
                    <a asp-controller="Order" asp-action="AddProduct" asp-route-productId="@product.Id" class="btn btn-success">Add</a>
                </div>
            </div>
        </div>
    }
</div>
