@using Microsoft.AspNetCore.Identity
@using Restaurant.Services
@using Restaurant.Extensions
@inject IOrderService OrderService
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurant.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container-fluid site-shell">
                <a class="navbar-brand site-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="site-brand-mark">R</span>
                    <span>
                        <strong>Restaurant</strong>
                        <small>Order and checkout</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @{
                    var userId = User.GetId();
                    var totalPrice = string.Empty;

                    if (!string.IsNullOrEmpty(userId))
                    {
                        var price = OrderService.GetTotalPrice(userId);
                        totalPrice = price.ToString("C");
                    }
                }

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 site-nav-list">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Menu" asp-action="GetAll">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Product" asp-action="GetAll">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Order" asp-action="GetAll">Cart</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Coupon" asp-action="GetAll">Offers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <div class="site-nav-actions">
                        @if (!string.IsNullOrEmpty(userId))
                        {
                            <a class="cart-pill" asp-area="" asp-controller="Order" asp-action="GetAll">
                                <span>Cart total</span>
                                <strong>@totalPrice</strong>
                            </a>
                        }

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main site-shell">
            @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-shell footer-content">
            <div>
                <strong>Restaurant</strong>
                <p>Menu browsing, cart management, and provider-backed checkout in one flow.</p>
            </div>
            <div class="footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Menu" asp-action="GetAll">Menu</a>
                <a asp-area="" asp-controller="Order" asp-action="GetAll">Cart</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <div class="footer-meta">
                &copy; 2026 Restaurant
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
