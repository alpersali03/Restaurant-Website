@using Restaurant.Data.Models
@model Order

@{
    ViewBag.Title = "Your Cart";
}

<h2>Your Cart</h2>

@if (Model.OrderItems == null || !Model.OrderItems.Any())
{
    <h1>Your cart is empty.</h1>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>
                        <img src="@item.Product?.ImageUrl" alt="@item.Product?.Name" width="100" />
                    </td>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Product?.Price ?? 0m).ToString("C"))</td>
                    <td>@(((item.Product?.Price ?? 0m) * item.Quantity).ToString("C"))</td>
                    <td>
                        <form asp-action="RemoveItem" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderItemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            <button type="submit" name="change" value="increase" class="btn btn-sm btn-success">+</button>
                            <button type="submit" name="change" value="decrease" class="btn btn-sm btn-warning">-</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total: @Model.TotalAmount.ToString("C")</h4>

    <a class="btn btn-primary" asp-controller="Checkout" asp-action="Confirmation" asp-route-orderId="@Model.Id">Checkout</a>

}
