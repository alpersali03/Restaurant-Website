@model Restaurant.DTOs.ProductFormDto

@{
    ViewData["Title"] = "Edit Product";
}

<section class="page-panel admin-form-shell">
    <div class="page-header">
        <div>
            <span class="eyebrow">Admin • Products</span>
            <h1>Edit product</h1>
            <p>Update menu copy, media, pricing, and category assignment.</p>
        </div>
        <a asp-controller="Product" asp-action="GetAll" class="btn btn-outline-dark">Back to products</a>
    </div>

    <form method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="admin-form-grid">
            <div class="form-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="small text-danger"></span>
            </div>

            <div class="form-field form-field-full">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="small text-danger"></span>
            </div>

            <div class="form-field form-field-full">
                <label asp-for="ImageUrl"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" class="form-select">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="small text-danger"></span>
            </div>

            <div class="form-field">
                <label class="form-label">Visibility</label>
                <div class="toggle-field">
                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                    <label asp-for="IsAvailable" class="form-check-label mb-0">Show this item to customers</label>
                </div>
                <span asp-validation-for="IsAvailable" class="small text-danger"></span>
            </div>
        </div>

        <div class="page-actions">
            <button class="btn btn-dark" type="submit">Save changes</button>
            <a asp-controller="Product" asp-action="GetAll" class="btn btn-outline-dark">Cancel</a>
        </div>
    </form>
</section>
