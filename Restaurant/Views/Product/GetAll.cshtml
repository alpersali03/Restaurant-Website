@model List<Restaurant.DTOs.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<section class="page-panel">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">Admin • Products</span>
            <h1 class="mb-2">Manage products</h1>
            <p class="table-note">Edit pricing, imagery, category placement, and availability from one screen.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Menu" asp-action="GetAll" class="btn btn-outline-dark">Customer menu</a>
            <a asp-controller="Product" asp-action="Add" class="btn btn-dark">Add product</a>
        </div>
    </div>

    <div class="admin-grid">
        @foreach (var product in Model)
        {
            <article class="admin-card">
                <img src="@product.ImageUrl" class="admin-card-image" alt="@product.Name" />
                <div class="admin-card-body">
                    <div class="admin-card-topline">
                        <span class="menu-badge">@(product.Category?.Name ?? "Uncategorized")</span>
                        <span class="metric-pill @(product.IsAvailable ? "status-success" : "status-muted")">
                            @(product.IsAvailable ? "Available" : "Hidden")
                        </span>
                    </div>

                    <div>
                        <h3>@product.Name</h3>
                        <p>@product.Description</p>
                    </div>

                    <div class="metric-row">
                        <span class="metric-label">Current price</span>
                        <strong class="menu-price">@product.Price.ToString("C")</strong>
                    </div>

                    <div class="admin-card-actions">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-dark btn-sm">Preview</a>
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-controller="Product" asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
